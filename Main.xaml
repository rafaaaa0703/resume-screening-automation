requirements.Contains(&quot;2+&quot;) OrElse requirements.Contains(&quot;2 years&quot;)) AndAlso (normalized.Contains(&quot;2 years&quot;) OrElse normalized.Contains(&quot;3 years&quot;) OrElse normalized.Contains(&quot;4 years&quot;) OrElse normalized.Contains(&quot;5 years&quot;)) Then&#xA;  points = points + 15&#xA;  matched.Add(&quot;Experience&quot;)&#xA;End If&#xA;score = points&#xA;matchedSkills = String.Join(&quot;, &quot;, matched)&#xA;decision = If(points &gt;= 75, &quot;Shortlist&quot;, If(points &gt;= 50, &quot;Human Review&quot;, &quot;Not Shortlisted&quot;))">
